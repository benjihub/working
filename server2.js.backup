// In-memory deduplication for webhook events (prevent spam on duplicates)
const processedEvents = new Map(); // id -> timestamp
function isDuplicateEvent(eventId, ttlMs = 5 * 60 * 1000) {
  if (!eventId) return false;
  const now = Date.now();
  const prev = processedEvents.get(eventId);
  if (prev && now - prev < ttlMs) return true;
  processedEvents.set(eventId, now);
  // occasional prune
  if (processedEvents.size > 5000) {
    const cutoff = now - ttlMs;
    for (const [id, ts] of processedEvents) {
      if (ts < cutoff) processedEvents.delete(id);
    }
  }
  return false;
}

function removeDuplicateEvent(eventId) {
  if (!eventId) return;
  processedEvents.delete(eventId);
}

if (!global.__handledMessagesByChat) {
  global.__handledMessagesByChat = new Map();
}

function clearHandledMessage(chatId, signature) {
  if (!chatId || !signature) return;
  const map = global.__handledMessagesByChat;
  const entries = map.get(chatId);
  if (!entries) return;
  entries.delete(signature);
  if (entries.size === 0) {
    map.delete(chatId);
  }
}

function markHandledMessage(chatId, signature) {
  if (!chatId || !signature) return;
  const map = global.__handledMessagesByChat;
  let entries = map.get(chatId);
  if (!entries) {
    entries = new Set();
    map.set(chatId, entries);
  }
  entries.add(signature);
}

function hasHandledMessage(chatId, signature) {
  if (!chatId || !signature) return false;
  const map = global.__handledMessagesByChat;
  const entries = map.get(chatId);
  return entries ? entries.has(signature) : false;
}

function buildMessageSignature(chatId, eventId, text) {
  return [chatId || 'unknown', eventId || 'none', (text || '').trim().slice(0, 120)].join('::');
}

const ASSISTANT_DUP_TTL_MS = parseInt(process.env.ASSISTANT_DUP_TTL_MS || '60000', 10);
if (!global.__recentAssistantMessages) {
  global.__recentAssistantMessages = new Map();
}

// Global Auto AI: Request-level locking to prevent concurrent processing duplicates
if (!global.__activeChatLocks) {
  global.__activeChatLocks = new Set();
}
const activeChatLocks = global.__activeChatLocks;

function normalizeAssistantText(text) {
  return (text || '').toString().trim();
}

function shouldSkipAssistantMessage(chatId, text, { senderId = null } = {}, ttlMs = ASSISTANT_DUP_TTL_MS) {
  if (!chatId) return false;
  const normalized = normalizeAssistantText(text);
  if (!normalized) return false;

  const counts = global.__messageCountsByChat?.get(chatId);
  if (counts) {
    const maxPerUser = Math.max(1, parseInt(process.env.ASSISTANT_MAX_PER_USER_MESSAGE || '1', 10));
    const assistantSinceUser = counts.assistantSinceUser || 0;
    const lastUserAt = counts.lastUserAt || 0;
    const lastAssistantAt = counts.lastAssistantAt || 0;
    if (lastUserAt > 0 && lastAssistantAt >= lastUserAt && assistantSinceUser >= maxPerUser) {
      console.log(`🚫 Assistant limit reached for chat ${chatId} (since last user message: ${assistantSinceUser}/${maxPerUser}).`);
      return true;
    }
  }

  const map = global.__recentAssistantMessages;
  const entry = map.get(chatId);
  if (!entry) return false;

  const now = Date.now();

  if (entry.text === normalized) {
    if (!entry.by || !senderId || entry.by === senderId) {
      console.log(`🚫 Duplicate assistant text detected for chat ${chatId}, blocking resend.`);
      return true;
    }
  }

  const RATE_LIMIT_MS = 5000;
  if (now - entry.at < RATE_LIMIT_MS) {
    console.log(`🚫 Rate limiting assistant message (too soon): ${now - entry.at}ms since last message`);
    return true;
  }

  if (now - entry.at > ttlMs) {
    map.delete(chatId);
    return false;
  }

  return false;
}

function rememberAssistantMessage(chatId, text, { senderId = null } = {}) {
  if (!chatId) return;
  const normalized = normalizeAssistantText(text);
  if (!normalized) return;
  global.__recentAssistantMessages.set(chatId, { text: normalized, at: Date.now(), by: senderId || null });
}

if (!global.__messageCountsByChat) {
  global.__messageCountsByChat = new Map();
}

function trackMessage(chatId, role) {
  if (!chatId || (role !== 'user' && role !== 'assistant')) return;
  let counts = global.__messageCountsByChat.get(chatId);
  if (!counts) {
    counts = {
      user: 0,
      assistant: 0,
      assistantSinceUser: 0,
      lastUserAt: 0,
      lastAssistantAt: 0,
      lastRole: null,
      lastAt: 0
    };
    global.__messageCountsByChat.set(chatId, counts);
  }

  const now = Date.now();
  if (role === 'user') {
    counts.user = (counts.user || 0) + 1;
    counts.lastUserAt = now;
    counts.assistantSinceUser = 0;
  } else {
    counts.assistant = (counts.assistant || 0) + 1;
    counts.lastAssistantAt = now;
    const lastUserAt = counts.lastUserAt || 0;
    if (!lastUserAt || now <= lastUserAt) {
      counts.assistantSinceUser = Math.max(1, counts.assistantSinceUser || 0);
    } else {
      counts.assistantSinceUser = (counts.assistantSinceUser || 0) + 1;
    }
  }
  counts.lastRole = role;
  counts.lastAt = now;

  if (global.__messageCountsByChat.size > 1000) {
    const keep = 800;
    let removed = 0;
    for (const key of global.__messageCountsByChat.keys()) {
      if (removed >= (global.__messageCountsByChat.size - keep)) break;
      global.__messageCountsByChat.delete(key);
      removed++;
    }
  }
}

function hasExceededMessageRatio(chatId) {
  if (!chatId) return false;
  const counts = global.__messageCountsByChat.get(chatId);
  if (!counts || counts.user === 0) return false;
  if (counts.user <= 3) return false;
  return counts.assistant >= counts.user;
}

function parseEnvList(key, fallback = '') {
  const raw = process.env[key];
  if (raw == null || raw === '') return fallback.split(',').map((s) => s.trim()).filter(Boolean);
  if (Array.isArray(raw)) return raw.map((s) => String(s).trim()).filter(Boolean);
  return String(raw)
    .split(',')
    .map((s) => s.trim())
    .filter(Boolean);
}

function evaluateChatIdForSend(chatId, req, payload) {
  const allowFake = String(process.env.ALLOW_FAKE_LIVECHAT_CHAT_IDS || '').toLowerCase() === 'true';
  if (allowFake) {
    return { skip: false, reason: null, match: null, allowFake };
  }

  const minLength = Math.max(4, parseInt(process.env.LIVECHAT_MIN_CHAT_ID_LENGTH || '4', 10) || 4);
  const normalized = (chatId == null ? '' : String(chatId)).trim();
  const lower = normalized.toLowerCase();

  const headerFlag = String(req.headers['x-local-test'] || '').toLowerCase();
  if (headerFlag === 'true') {
    return { skip: true, reason: 'local_test_header', match: null, allowFake };
  }

  if (payload?.is_local_test === true || payload?.metadata?.is_local_test === true) {
    return { skip: true, reason: 'local_test_flag', match: null, allowFake };
  }

  if (!normalized) {
    return { skip: true, reason: 'missing_chat_id', match: null, allowFake };
  }

  if (lower.length < minLength) {
    return { skip: true, reason: 'short_chat_id', match: lower.length, allowFake };
  }

  const prefixList = parseEnvList('LIVECHAT_FAKE_CHAT_ID_PREFIXES', 'test_,demo_,local_,sample_').map((p) => p.toLowerCase());
  const matchingPrefix = prefixList.find((prefix) => prefix && lower.startsWith(prefix));
  if (matchingPrefix) {
    return { skip: true, reason: 'fake_prefix', match: matchingPrefix, allowFake };
  }

  const fakeExactList = parseEnvList('LIVECHAT_FAKE_CHAT_IDS', '').map((id) => id.toLowerCase());
  if (fakeExactList.includes(lower)) {
    return { skip: true, reason: 'fake_exact', match: lower, allowFake };
  }

  return { skip: false, reason: null, match: null, allowFake };
}

function matchSecretFromSignature(signatureHeader, rawBodyBuffer, allowedSecrets) {
  if (!signatureHeader || !rawBodyBuffer || !allowedSecrets || allowedSecrets.size === 0) {
    return null;
  }
  const headerParts = String(signatureHeader)
    .split(',')
    .map((part) => part.trim())
    .filter(Boolean);
  if (!headerParts.length) return null;

  const headerLower = headerParts.map((part) => part.toLowerCase());
  for (const secret of allowedSecrets) {
    try {
      const sha256Hex = crypto.createHmac('sha256', secret).update(rawBodyBuffer).digest('hex');
      const sha256Base64 = crypto.createHmac('sha256', secret).update(rawBodyBuffer).digest('base64');
      const sha1Hex = crypto.createHmac('sha1', secret).update(rawBodyBuffer).digest('hex');
      const candidates = [
        sha256Hex,
        sha256Base64,
        `sha256=${sha256Hex}`,
        `sha256=${sha256Base64}`,
        sha1Hex,
        `sha1=${sha1Hex}`
      ].map((val) => val.toLowerCase());

      for (const hdr of headerLower) {
        if (candidates.includes(hdr)) {
          return secret;
        }
      }
    } catch (err) {
      console.warn('Non-fatal: failed computing webhook signature candidate', err?.message || err);
    }
  }
  return null;
}

// Function to get server instance
function getServerInstance() {
  if (!serverInstance) {
    throw new Error('Server not initialized');
  }
  return serverInstance;
}

// Function to start the server
const startServer = async () => {
  try {
    await initializeDatabase();
    try {
      const initialAutoState = await getGlobalAutoAiState();
      global.__globalAutoAiState = Object.assign({}, global.__globalAutoAiState, initialAutoState || {});
    } catch (stateErr) {
      console.warn('Unable to read initial Global Auto AI state:', stateErr?.message || stateErr);
    }

    // Webhook responder and Agent Chat Manager work together for auto-replies
    agentChatManager.setAutoReplyEnabled(true);
    
    // Helper to attempt listening on a port and resolve/reject accordingly
    const listenOnce = (port) => new Promise((resolve, reject) => {
      const server = app.listen(port, () => resolve(server));
      server.on('error', (err) => reject(err));
    });

    // Try initial port, then next two if busy (total up to 3 attempts)
    let portToTry = INITIAL_PORT;
    let attemptsLeft = 2;
    while (true) {
      try {
        const server = await listenOnce(portToTry);
        serverInstance = server;
        activePort = portToTry;

        const addressInfo = server.address();
        let localUrl = `http://localhost:${portToTry}`;
        let networkUrl = `http://${getLocalIpAddress()}:${portToTry}`;
        if (addressInfo) {
          if (typeof addressInfo === 'string') {
            localUrl = addressInfo;
            networkUrl = addressInfo;
          } else if (typeof addressInfo === 'object' && addressInfo.port) {
            localUrl = `http://localhost:${addressInfo.port}`;
            networkUrl = `http://${getLocalIpAddress()}:${addressInfo.port}`;
          }
        }

        console.log(`\n🚀 Server Details:`);
        console.log(`   • Address: ${localUrl}`);
        console.log(`   • Network: Accessible from other devices on the network`);
        console.log(`   • Time: ${new Date().toISOString()}`);

        console.log('\n🔍 Available Endpoints:');
        console.log(`   • GET  /api/promotions - List all promotions`);
        console.log(`   • POST /api/promotions - Add a new promotion`);
        console.log(`   • PUT  /api/promotions/:id - Update a promotion`);
        console.log(`   • DELETE /api/promotions/:id - Delete a promotion`);
        console.log(`   • GET  /api/rtp - Get RTP link (JSON)`);
        console.log(`   • PUT  /api/rtp - Update RTP link (persisted)`);
        console.log(`   • POST /api/rtp - Get RTP link (JSON)`);
        console.log(`   • GET  /api/trp - Alias RTP link (JSON)`);
        console.log(`   • POST /api/trp - Alias RTP link (JSON)`);

        console.log('\n✨ Server Features:');
        console.log('   • Payment processing automation');
        console.log('   • Real-time promotions management');
        console.log('   • Smart AI response generation');
        console.log('   • Bilingual support (EN/ID)');

        console.log('\nServer is running on:');
        console.log(`   - Local: ${localUrl}`);
        console.log(`   - Network: ${networkUrl}`);
        console.log('\n✨ Server is ready!');

        if (String(process.env.DISABLE_LIVECHAT_WEBHOOK || '').toLowerCase() === 'true') {
          console.warn('⚠️ LiveChat webhooks are disabled. Chats will not be processed until they are enabled.');
        } else {
          // Start Agent Chat Manager for bubble detection and responses
          console.log('\n🤖 Starting Agent Chat Manager...');
          agentChatManager.start();

          // Start SSE LiveChat Manager if enabled
          if (liveChatSSE) {
            console.log('\n🔌 Starting LiveChat SSE Manager...');
            liveChatSSE.startLiveChatPolling();
            console.log('✅ SSE LiveChat integration active');
            console.log('📡 AI can connect to: /api/livechat/sse');
          } else {
            console.log('ℹ️  SSE LiveChat integration disabled (set ENABLE_LIVECHAT_SSE=true to enable)');
          }
        }

        // Also attach a generic error logger for runtime errors
        server.on('error', (error) => {
          console.error('\n❌ Server error:', error);
        });
        break; // success
      } catch (error) {
        if (error.code === 'EADDRINUSE' && attemptsLeft > 0) {
          console.error(`\n❌ Port ${portToTry} in use. Retrying on ${portToTry + 1}...`);
          portToTry += 1;
          attemptsLeft -= 1;
          continue;
        }
        if (error.code === 'EADDRINUSE') {
          console.error(`\n❌ All attempted ports are in use starting from ${INITIAL_PORT}.`);
          console.log('Please close the other application or set a free PORT in .env.');
        } else {
          console.error('\n❌ Failed to start server:', error);
        }
        process.exit(1);
      }
    }

  } catch (error) {
    console.error('❌ Failed to start server:', error);
    process.exit(1);
  }
};

// Start the server
startServer().catch(error => {
  console.error('❌ Failed to start server:', error);
  process.exit(1);
});

// Track active users and open tickets
const activeUsers = new Set();
const openTickets = new Set();

// Helper function to update chat activity
async function updateChatActivity(chatId, userId) {
  const now = Math.floor(Date.now() / 1000);
  activeUsers.add(userId);
  openTickets.add(chatId);

  // Update last activity in the database (better-sqlite3 is synchronous)
  try {
    if (!db) {
      // Lazy acquire if global not yet set (should normally be set by startServer)
      db = await getDb();
    }
    db.prepare('INSERT OR IGNORE INTO chats (id, state, last_activity) VALUES (?, ?, ?)')
      .run(chatId, '{}', now);
    db.prepare('UPDATE chats SET last_activity = ? WHERE id = ?')
      .run(now, chatId);
  } catch (error) {
    console.error('Error updating chat activity:', error);
  }
}


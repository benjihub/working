// Global Auto AI: Track processed events to prevent duplicates
const _processedAutoAiEvents = new Map(); // chatId -> Set(eventIds)
const MAX_CACHE_SIZE = 1000; // Prevent memory leak

function hasProcessedAutoAiEvent(chatId, eventId) {
  const events = _processedAutoAiEvents.get(chatId);
  return events && events.has(eventId);
}

function markAutoAiEventProcessed(chatId, eventId) {
  if (!_processedAutoAiEvents.has(chatId)) {
    _processedAutoAiEvents.set(chatId, new Set());
  }
  _processedAutoAiEvents.get(chatId).add(eventId);
  
  // Clean up old entries if cache gets too large
  if (_processedAutoAiEvents.size > MAX_CACHE_SIZE) {
    const firstKey = _processedAutoAiEvents.keys().next().value;
    _processedAutoAiEvents.delete(firstKey);
  }
}

function normalizeEventTimestamp(ts) {
  if (ts == null) return '';
  if (typeof ts === 'number') {
    if (ts > 1e12) return new Date(ts).toISOString();
    if (ts > 1e9) return new Date(ts * 1000).toISOString();
    return String(ts);
  }
  const str = String(ts).trim();
  if (!str) return '';
  const parsed = new Date(str);
  if (!Number.isNaN(parsed.getTime())) return parsed.toISOString();
  return str;
}

function buildEventIdentity(chatId, eventId, { text = '', authorId = null, createdAt = null } = {}) {
  const normalizedText = (text == null ? '' : String(text));
  const trimmedText = normalizedText.trim();
  const ts = normalizeEventTimestamp(createdAt);
  const rawId = eventId != null && String(eventId).trim() !== '' ? String(eventId).trim() : null;
  const fallbackIdBase = `${ts}|${authorId != null ? String(authorId).trim() : ''}|${normalizedText.slice(0, 25)}`;
  const normalizedEventId = rawId || (fallbackIdBase && fallbackIdBase.trim() !== '' ? fallbackIdBase : `anon:${chatId || ''}:${trimmedText.slice(0, 50)}`);
  const fingerprintSource = [chatId || 'unknown', normalizedEventId, trimmedText.slice(0, 120)].join('||');
  const fingerprint = crypto.createHash('sha1').update(fingerprintSource).digest('hex');
  return { normalizedEventId, fingerprint };
}

function normalizeCustomerText(text) {
  if (text == null) return '';
  return String(text)
    .replace(/\s+/g, ' ')
    .trim()
    .toLowerCase();
}

function normalizeAuthorId(authorId) {
  if (authorId == null || authorId === '') return 'anon';
  return String(authorId).trim().toLowerCase();
}

function buildCustomerMessageSignature(chatId, text, authorId) {
  const normalizedText = normalizeCustomerText(text);
  const normalizedAuthor = normalizeAuthorId(authorId);
  const source = [chatId || 'unknown', normalizedAuthor, normalizedText].join('||');
  const signature = crypto.createHash('sha1').update(source).digest('hex');
  return {
    signature,
    normalizedText,
    normalizedAuthor
  };
}


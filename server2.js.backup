// Test webhook processing (for development and testing)
app.post('/api/webhook/test', auth.authMiddleware(), async (req, res) => {
  try {
    if (req.user.role !== 'owner' && req.user.role !== 'master') {
      return res.status(403).json({ success: false, error: 'Insufficient permissions' });
    }
    
    const { chatId, message, skipLiveChat = true } = req.body;
    
    if (!chatId || !message) {
      return res.status(400).json({ success: false, error: 'chatId and message are required' });
    }
    
    console.log('\n🧪 ===== WEBHOOK TEST STARTED =====');
    console.log(`📱 Test Chat ID: ${chatId}`);
    console.log(`📝 Test Message: "${message}"`);
    console.log(`⏰ Started: ${new Date().toLocaleString()}`);
    
    const startTime = Date.now();
    
    // Test the AI response system
    let reply = null;
    try {
      gcGetChatState(chatId);
      reply = await gcGetResponse(chatId, message, `${chatId}_test_${Date.now()}`);
    } catch (e) {
      console.error('❌ Test AI response failed:', e.message);
    }
    
    const processingTime = Date.now() - startTime;
    
    const result = {
      success: true,
      testResults: {
        chatId,
        inputMessage: message,
        aiResponse: reply,
        processingTimeMs: processingTime,
        timestamp: new Date().toISOString(),
        performanceRating: processingTime < 1000 ? 'Fast' : processingTime < 3000 ? 'Good' : processingTime < 5000 ? 'Slow' : 'Very Slow'
      }
    };
    
    console.log(`✅ Test completed in ${processingTime}ms`);
    console.log(`📝 AI Response: "${reply?.slice(0, 100)}${reply?.length > 100 ? '...' : ''}"`);
    console.log('🧪 ===========================\n');
    
    // Optionally send to LiveChat if not skipped
    if (!skipLiveChat && reply) {
      const groupMapping = await getChatGroup(chatId);
      const internalGroupId = groupMapping ? (Number(groupMapping.group_id ?? groupMapping.groupId ?? groupMapping) || null) : null;
      const lcGroupId = internalGroupId ? await getGroupLivechatGroupId(internalGroupId) : null;
      try {
        await sendReply(
          {
            chat_id: chatId,
            chat: { id: chatId, group_id: lcGroupId }
          },
          reply,
          {
            internalGroupId,
            groupId: lcGroupId
          }
        );
        result.testResults.sentToLiveChat = true;
        console.log('📤 Test response sent to LiveChat');
      } catch (e) {
        result.testResults.liveChatError = e.message;
        console.warn('❌ Failed to send test response to LiveChat:', e.message);
      }
    }
    
    res.json(result);
    
  } catch (e) {
    res.status(500).json({ success: false, error: e.message });
  }
});

